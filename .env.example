# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# ---- Kev: the decision model that scores jobs ----
# Start the Kev server first (README: "Set up Kev"), then leave these as they are.
KEV_BASE_URL=http://127.0.0.1:8009
KEV_MODEL=kev-latest
# KEV_API_KEY=            # only if you start the Kev server with KEV_API_KEY set
KEV_TIMEOUT_SECONDS=120

# ---- Gemini (free tier): turns each posting into a short job card, and reads your resume ----
# Optional but recommended. Key: https://aistudio.google.com/apikey
# Your free limits per model are at https://aistudio.google.com/rate-limit; keep the two limits below under them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_RPM=10
GEMINI_DAILY_LIMIT=500

# ---- Email alerts (Gmail example) ----
# Gmail needs an App Password (Google Account > Security > App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
# Where the first account's alerts go until addresses are set on the dashboard. Comma-separate several.
ALERT_EMAIL_TO=you@gmail.com

# ---- Watching ----
# 1 = give every new account the ~100-company starter list
LOAD_DEFAULT_COMPANIES=1
CHECK_INTERVAL_MINUTES=30
# Ignore postings older than this many days. Jobs with no posted date are kept.
MAX_JOB_AGE_DAYS=10
# At most this many jobs are scored per company check; the rest wait for the next check.
MAX_EVALS_PER_RUN=50

# ---- Tuning (probabilities from 0 to 1) ----
# How sure Kev must be that a job is in your fields
RELATED_THRESHOLD=0.5
# How sure Kev must be that you meet each must-have requirement
ELIGIBLE_THRESHOLD=0.5

# ---- Rate limits and retries (all outgoing requests) ----
JOB_BOARD_RPS=2
KEV_RPM=60
SMTP_PER_MINUTE=20
RETRY_MAX_ATTEMPTS=4
RETRY_MAX_WAIT_SECONDS=90
PROVIDER_COOLDOWN_SECONDS=300
MAX_EVAL_ATTEMPTS=4
MAX_EMAIL_ATTEMPTS=4

# ---- App ----
# Link used in emails. Change it if you run this on a server; an https:// link also marks the login cookie Secure.
DASHBOARD_URL=http://localhost:8000
# 1 = anyone who can open the dashboard can create an account (each gets its own data). 0 = no new accounts.
ALLOW_SIGNUP=1
# Set this if the app is reachable from the internet; webhooks then need ?secret=... or an X-Webhook-Secret header.
WEBHOOK_SECRET=
# DB_PATH=data/thewatcher.db
